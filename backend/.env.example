# =============================================================================
# AI Study Companion Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="AI Study Companion"
APP_VERSION="0.1.0"
APP_DESCRIPTION="A production-ready backend for an AI-powered study companion."

# Runtime environment: development | staging | production
ENVIRONMENT=development

# Enable extra debug logging and error detail in responses
DEBUG=false


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000


# -----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins.
# Use ["*"] only for fully public APIs — never in production with credentials.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_METHODS=["*"]
ALLOWED_HEADERS=["*"]
ALLOW_CREDENTIALS=true


# -----------------------------------------------------------------------------
# File Upload
# -----------------------------------------------------------------------------
# Directory where uploaded files are stored (relative to app/ or absolute)
UPLOAD_DIR=app/uploads

# Maximum upload size in megabytes
MAX_UPLOAD_SIZE_MB=20

# Permitted file extensions (JSON list)
ALLOWED_EXTENSIONS=["pdf"]


# -----------------------------------------------------------------------------
# Text Chunking
# -----------------------------------------------------------------------------
# Target tokens per chunk
CHUNK_SIZE=512

# Token overlap between consecutive chunks
CHUNK_OVERLAP=64


# -----------------------------------------------------------------------------
# Embeddings
# HuggingFace model identifier. Model is downloaded on first use.
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Must match the output dimension of the chosen model
EMBEDDING_DIMENSION=384


# -----------------------------------------------------------------------------
# Qdrant Vector Database
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=study_documents

# Leave blank for local / self-hosted Qdrant; set for Qdrant Cloud
QDRANT_API_KEY=


# -----------------------------------------------------------------------------
# LLM Provider
# Choose one: openai | anthropic | ollama
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai


# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini


# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-haiku-20240307


# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3


# Shared LLM generation settings
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024


# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
# Number of chunks returned per similarity search
RETRIEVAL_TOP_K=5

# Minimum similarity score (0.0 – 1.0) to include a result
RETRIEVAL_SCORE_THRESHOLD=0.5


# -----------------------------------------------------------------------------
# Logging
# Levels: DEBUG | INFO | WARNING | ERROR | CRITICAL
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s | %(levelname)-8s | %(name)s | %(message)s"

# =============================================================================
# AI Study Companion Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="AI Study Companion"
APP_VERSION="0.1.0"
APP_DESCRIPTION="A production-ready backend for an AI-powered study companion."

# Runtime environment: development | staging | production
ENVIRONMENT=development

# Enable extra debug logging and error detail in responses
DEBUG=false


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000


# -----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins.
# Use ["*"] only for fully public APIs — never in production with credentials.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_METHODS=["*"]
ALLOWED_HEADERS=["*"]
ALLOW_CREDENTIALS=true


# -----------------------------------------------------------------------------
# File Upload
# -----------------------------------------------------------------------------
# Directory where uploaded files are stored (relative to app/ or absolute)
UPLOAD_DIR=app/uploads

# Maximum upload size in megabytes
MAX_UPLOAD_SIZE_MB=20

# Permitted file extensions (JSON list)
ALLOWED_EXTENSIONS=["pdf"]


# -----------------------------------------------------------------------------
# Text Chunking
# -----------------------------------------------------------------------------
# Target tokens per chunk
CHUNK_SIZE=512

# Token overlap between consecutive chunks
CHUNK_OVERLAP=64


# -----------------------------------------------------------------------------
# Embeddings — Gemini (active)
#
# The retrieval pipeline (POST /api/retrieve) uses Google Gemini
# text-embedding-004 to generate 768-dimensional query and document vectors.
#
# Get your key at: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=AIza...

# Gemini embedding model name — do not change unless Google releases a newer version
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Must match the output dimensionality of the Gemini model above.
# text-embedding-004 always produces 768-dim vectors.
GEMINI_EMBEDDING_DIMENSION=768

# Retry / timeout settings for Gemini API calls
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BACKOFF=2
EMBEDDING_TIMEOUT=30


# -----------------------------------------------------------------------------
# Embeddings — sentence-transformers (legacy / offline alternative)
# Used by services that were scaffolded before Gemini integration.
# Leave these set so offline utilities still work.
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384


# -----------------------------------------------------------------------------
# Qdrant Vector Database
#
# Two logical collections are used:
#   study_notes      — Gemini 768-dim vectors (POST /api/retrieve pipeline)
#   study_documents  — sentence-transformers 384-dim vectors (legacy pipeline)
#
# Run locally with Docker:
#   docker run -p 6333:6333 qdrant/qdrant
#
# Or use Qdrant Cloud: https://cloud.qdrant.io
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Full URL override — takes precedence over QDRANT_HOST + QDRANT_PORT when set
# QDRANT_URL=http://localhost:6333

# Collection for the Gemini retrieval pipeline (POST /api/retrieve)
STUDY_NOTES_COLLECTION=study_notes

# Collection for the legacy sentence-transformers pipeline
QDRANT_COLLECTION_NAME=study_documents

# Distance metric: Cosine | Euclid | Dot  (Cosine recommended for normalised vectors)
QDRANT_DISTANCE_METRIC=Cosine

# Leave blank for local / self-hosted Qdrant; required for Qdrant Cloud
QDRANT_API_KEY=


# -----------------------------------------------------------------------------
# LLM Provider
# Choose one: openai | anthropic | ollama | gemini
#
# The study-plan and Q&A pipelines default to Gemini.
# Set LLM_PROVIDER=gemini and fill in GEMINI_API_KEY to activate them.
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini


# --- Gemini (recommended — used by study-plan and Q&A pipelines) ---

# API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Gemini embedding model — do NOT change unless Google releases a newer version
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_EMBEDDING_DIMENSION=768

# Gemini generative (chat) model used by study-plan and Q&A
# Options: gemini-1.5-flash (fast, cheap) | gemini-1.5-pro (higher quality)
GEMINI_CHAT_MODEL=gemini-1.5-flash

# Retry / timeout settings for Gemini API calls
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BACKOFF=2
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BACKOFF=2
EMBEDDING_TIMEOUT=30


# --- OpenAI (alternative) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini


# --- Anthropic (alternative) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-haiku-20240307


# --- Ollama (local, no API key required) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3


# Shared LLM generation settings (apply to all providers)
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024


# -----------------------------------------------------------------------------
# Study Plan Generation
# -----------------------------------------------------------------------------
# Maximum times to re-prompt Gemini when it returns invalid JSON
STUDY_PLAN_MAX_JSON_RETRIES=3

# Seconds to wait between retry attempts (multiplied by attempt number)
STUDY_PLAN_RETRY_BACKOFF=1.5


# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
# Number of chunks returned per similarity search
RETRIEVAL_TOP_K=5

# Minimum similarity score (0.0 – 1.0) to include a result
RETRIEVAL_SCORE_THRESHOLD=0.5


# -----------------------------------------------------------------------------
# Logging
# Levels: DEBUG | INFO | WARNING | ERROR | CRITICAL
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s | %(levelname)-8s | %(name)s | %(message)s"
